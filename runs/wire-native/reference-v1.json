        "id": "ask",
        "name": "Ask for input",
        "description": "Parks the Task in INPUT_REQUIRED with a question, then completes it when a second message carrying the same taskId supplies the answer.",
        "tags": [
          "task",
          "input-required",
          "multi-turn"
