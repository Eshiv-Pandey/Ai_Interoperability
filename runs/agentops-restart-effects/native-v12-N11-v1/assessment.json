          {
            "name": "audit_log",
            "sql": "CREATE TABLE audit_log (\n    id              INTEGER PRIMARY KEY AUTOINCREMENT,\n    schema_version  INTEGER NOT NULL DEFAULT 1 CHECK (schema_version >= 1),\n    ts              TEXT NOT NULL,                         -- ISO-8601 UTC of the action\n    actor           TEXT NOT NULL,                         -- executing agent, e.g. \"agentops-agent\"\n    approved_by     TEXT NOT NULL,                         -- ADK user id; synthetic on unauthenticated A2A\n    rationale       TEXT NOT NULL,                         -- the approver's stated reason (HITL, Ch. 4.5)\n    context_summary TEXT NOT NULL,                         -- current decision context reconstructed at execution\n    session_id      TEXT NOT NULL,\n    invocation_id   TEXT NOT NULL,\n    action          TEXT NOT NULL,                         -- e.g. \"restart_service\", \"resolve_incident\"\n    target          TEXT NOT NULL,                         -- service name or incident id\n    detail          TEXT NOT NULL\n)",
            "tbl_name": "audit_log",
            "type": "table"
          },
          {
            "name": "incidents",
            "sql": "CREATE TABLE incidents (\n    id          TEXT PRIMARY KEY,                          -- human id, e.g. \"INC-001\"\n    service     TEXT NOT NULL REFERENCES services (name),\n    title       TEXT NOT NULL,\n    severity    TEXT NOT NULL CHECK (severity IN ('SEV1', 'SEV2', 'SEV3')),\n    status      TEXT NOT NULL CHECK (status IN ('open', 'investigating', 'resolved')),\n    runbook     TEXT NOT NULL,                             -- runbook slug (knowledge base key)\n    opened_at   TEXT NOT NULL,                             -- ISO-8601 UTC\n    resolved_at TEXT,                                      -- ISO-8601 UTC, NULL while unresolved\n    summary     TEXT NOT NULL\n)",
            "tbl_name": "incidents",
            "type": "table"
          },
          {
            "name": "services",
            "sql": "CREATE TABLE services (\n    name        TEXT PRIMARY KEY,                          -- stable slug, e.g. \"checkout\"\n    description TEXT NOT NULL,\n    status      TEXT NOT NULL CHECK (status IN ('operational', 'degraded', 'down')),\n    owner       TEXT NOT NULL                              -- owning team\n)",
            "tbl_name": "services",
            "type": "table"
          },
          {
            "name": "sqlite_sequence",
            "sql": "CREATE TABLE sqlite_sequence(name,seq)",
            "tbl_name": "sqlite_sequence",
            "type": "table"
          },
          {
            "name": "audit_log_no_delete",
            "sql": "CREATE TRIGGER audit_log_no_delete\nBEFORE DELETE ON audit_log\nBEGIN\n    SELECT RAISE(ABORT, 'audit_log is append-only');\nEND",
            "tbl_name": "audit_log",
            "type": "trigger"
          },
          {
            "name": "audit_log_no_update",
            "sql": "CREATE TRIGGER audit_log_no_update\nBEFORE UPDATE ON audit_log\nBEGIN\n    SELECT RAISE(ABORT, 'audit_log is append-only');\nEND",
            "tbl_name": "audit_log",
            "type": "trigger"
          }
