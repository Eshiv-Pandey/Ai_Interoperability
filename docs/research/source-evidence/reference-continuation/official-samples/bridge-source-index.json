      "excerpt_ranges": [
        {
          "start": 176,
          "end": 201,
          "lines": [
            {
              "line": 176,
              "text": "      name: \"a2a_send_message\",\r"
            },
            {
              "line": 177,
              "text": "      title: \"Send a message to an A2A agent\",\r"
            },
            {
              "line": 178,
              "text": "      description:\r"
            },
            {
              "line": 179,
              "text": "        \"Sends one text message to an A2A agent and returns its answer, which is either a \" +\r"
            },
            {
              "line": 180,
              "text": "        \"direct message or a task. The reply carries a context handle, and a task handle \" +\r"
            },
            {
              "line": 181,
              "text": "        \"when the agent opened a task. Pass contextHandle back to continue the same \" +\r"
            },
            {
              "line": 182,
              "text": "        \"conversation, and taskHandle back to answer a task the agent left waiting for \" +\r"
            },
            {
              "line": 183,
              "text": "        `input. ${retention}`,\r"
            },
            {
              "line": 184,
              "text": "      inputSchema: z.object({\r"
            },
            {
              "line": 185,
              "text": "        agent: agentEnum,\r"
            },
            {
              "line": 186,
              "text": "        text: z.string().min(1).describe(\"The message text to send to the agent.\"),\r"
            },
            {
              "line": 187,
              "text": "        contextHandle: z\r"
            },
            {
              "line": 188,
              "text": "          .string()\r"
            },
            {
              "line": 189,
              "text": "          .optional()\r"
            },
            {
              "line": 190,
              "text": "          .describe(\"Context handle returned by an earlier call, to continue that conversation.\"),\r"
            },
            {
              "line": 191,
              "text": "        taskHandle: z\r"
            },
            {
              "line": 192,
              "text": "          .string()\r"
            },
            {
              "line": 193,
              "text": "          .optional()\r"
            },
            {
              "line": 194,
              "text": "          .describe(\"Task handle returned by an earlier call, to answer a task awaiting input.\"),\r"
            },
            {
              "line": 195,
              "text": "      }),\r"
            },
            {
              "line": 196,
              "text": "      argsSchema: z.object({\r"
            },
            {
              "line": 197,
              "text": "        agent: agentString,\r"
            },
            {
              "line": 198,
              "text": "        text: z.string().min(1),\r"
            },
            {
              "line": 199,
              "text": "        contextHandle: z.string().optional(),\r"
            },
            {
              "line": 200,
              "text": "        taskHandle: z.string().optional(),\r"
            },
            {
              "line": 201,
              "text": "      }),\r"
            }
          ]
        },
        {
          "start": 254,
          "end": 309,
          "lines": [
            {
              "line": 254,
              "text": "async function sendMessage(\r"
            },
            {
              "line": 255,
              "text": "  args: Record<string, unknown>,\r"
            },
            {
              "line": 256,
              "text": "  deps: ToolDeps,\r"
            },
            {
              "line": 257,
              "text": "  context: CallContext,\r"
            },
            {
              "line": 258,
              "text": "): Promise<CallToolResult | InputRequiredResult> {\r"
            },
            {
              "line": 259,
              "text": "  const alias = String(args[\"agent\"]);\r"
            },
            {
              "line": 260,
              "text": "  // Validates the alias without a fetch: a handle is checked before the\r"
            },
            {
              "line": 261,
              "text": "  // network, so an unknown handle is reported as such even when the agent\r"
            },
            {
              "line": 262,
              "text": "  // card happens to be unreachable.\r"
            },
            {
              "line": 263,
              "text": "  deps.cards.cardUrlOf(alias);\r"
            },
            {
              "line": 264,
              "text": "\r"
            },
            {
              "line": 265,
              "text": "  if (context.requestState !== undefined) {\r"
            },
            {
              "line": 266,
              "text": "    // A later round of a multi-round-trip: the arguments are the ones the\r"
            },
            {
              "line": 267,
              "text": "    // first round was called with, and what matters is the answer the client\r"
            },
            {
              "line": 268,
              "text": "    // collected and the task the verified state names.\r"
            },
            {
              "line": 269,
              "text": "    return deps.mrtr.resume(alias, context.requestState, context.inputResponses);\r"
            },
            {
              "line": 270,
              "text": "  }\r"
            },
            {
              "line": 271,
              "text": "\r"
            },
            {
              "line": 272,
              "text": "  let contextId: string | undefined;\r"
            },
            {
              "line": 273,
              "text": "  let taskId: string | undefined;\r"
            },
            {
              "line": 274,
              "text": "\r"
            },
            {
              "line": 275,
              "text": "  const taskHandle = args[\"taskHandle\"];\r"
            },
            {
              "line": 276,
              "text": "  if (typeof taskHandle === \"string\") {\r"
            },
            {
              "line": 277,
              "text": "    const record = deps.handles.tasks.resolve(taskHandle);\r"
            },
            {
              "line": 278,
              "text": "    assertSameAgent(alias, record.alias, taskHandle);\r"
            },
            {
              "line": 279,
              "text": "    taskId = record.a2aTaskId;\r"
            },
            {
              "line": 280,
              "text": "    contextId = record.contextId;\r"
            },
            {
              "line": 281,
              "text": "  }\r"
            },
            {
              "line": 282,
              "text": "\r"
            },
            {
              "line": 283,
              "text": "  const contextHandle = args[\"contextHandle\"];\r"
            },
            {
              "line": 284,
              "text": "  if (typeof contextHandle === \"string\") {\r"
            },
            {
              "line": 285,
              "text": "    const record = deps.handles.resolveContext(contextHandle);\r"
            },
            {
              "line": 286,
              "text": "    assertSameAgent(alias, record.alias, contextHandle);\r"
            },
            {
              "line": 287,
              "text": "    contextId = record.contextId;\r"
            },
            {
              "line": 288,
              "text": "  }\r"
            },
            {
              "line": 289,
              "text": "\r"
            },
            {
              "line": 290,
              "text": "  const input = {\r"
            },
            {
              "line": 291,
              "text": "    text: String(args[\"text\"]),\r"
            },
            {
              "line": 292,
              "text": "    ...(contextId === undefined ? {} : { contextId }),\r"
            },
            {
              "line": 293,
              "text": "    ...(taskId === undefined ? {} : { taskId }),\r"
            },
            {
              "line": 294,
              "text": "  };\r"
            },
            {
              "line": 295,
              "text": "\r"
            },
            {
              "line": 296,
              "text": "  if (context.tasksExtension) {\r"
            },
            {
              "line": 297,
              "text": "    // The client can hold an MCP task, so an A2A task becomes one instead of\r"
            },
            {
              "line": 298,
              "text": "    // being waited out inside the tool call.\r"
            },
            {
              "line": 299,
              "text": "    const outcome = await deps.tasks.createTask(alias, input);\r"
            },
            {
              "line": 300,
              "text": "    if (outcome.kind === \"task\") {\r"
            },
            {
              "line": 301,
              "text": "      return outcome.result as unknown as CallToolResult;\r"
            },
            {
              "line": 302,
              "text": "    }\r"
            },
            {
              "line": 303,
              "text": "    return resultEnvelope(deps.handles, alias, outcome.result) as CallToolResult;\r"
            },
            {
              "line": 304,
              "text": "  }\r"
            },
            {
              "line": 305,
              "text": "\r"
            },
            {
              "line": 306,
              "text": "  const result = await deps.agents.sendMessage(alias, input);\r"
            },
            {
              "line": 307,
              "text": "  if (context.elicitation && isTask(result) && MrtrService.isWaitingForInput(result)) {\r"
            },
            {
              "line": 308,
              "text": "    // The client cannot hold an MCP task but can answer a question, so the\r"
            },
            {
              "line": 309,
              "text": "    // interruption becomes an elicitation the client fulfils and replays,\r"
            }
          ]
        }
      ]
    },
