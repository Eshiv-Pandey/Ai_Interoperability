            {
              "line": 67,
              "text": "/** What a2a_send_message hands to the upstream agent. */\r"
            },
            {
              "line": 68,
              "text": "export interface SendMessageInput {\r"
            },
            {
              "line": 69,
              "text": "  text: string;\r"
            },
            {
              "line": 70,
              "text": "  /** A2A context id, to continue a conversation. */\r"
            },
            {
              "line": 71,
              "text": "  contextId?: string;\r"
            },
            {
              "line": 72,
              "text": "  /** A2A task id, to answer a task parked in INPUT_REQUIRED. */\r"
            },
            {
              "line": 73,
              "text": "  taskId?: string;\r"
            },
            {
              "line": 74,
              "text": "}\r"
            },
            {
              "line": 75,
              "text": "\r"
            }
          ]
        },
        {
          "start": 207,
          "end": 225,
          "lines": [
            {
              "line": 207,
              "text": "export function buildUserMessage(input: SendMessageInput): Message {\r"
            },
            {
              "line": 208,
              "text": "  const part: Part = {\r"
            },
            {
              "line": 209,
              "text": "    content: { $case: \"text\", value: input.text },\r"
            },
            {
              "line": 210,
              "text": "    metadata: undefined,\r"
            },
            {
              "line": 211,
              "text": "    filename: \"\",\r"
            },
            {
              "line": 212,
              "text": "    mediaType: \"text/plain\",\r"
            },
            {
              "line": 213,
              "text": "  };\r"
            },
            {
              "line": 214,
              "text": "  return {\r"
            },
            {
              "line": 215,
              "text": "    messageId: randomUUID(),\r"
            },
            {
              "line": 216,
              "text": "    contextId: input.contextId ?? \"\",\r"
            },
            {
              "line": 217,
              "text": "    taskId: input.taskId ?? \"\",\r"
            },
            {
              "line": 218,
              "text": "    // Role is a numeric ts-proto enum: the string \"ROLE_USER\" would serialize\r"
            },
            {
              "line": 219,
              "text": "    // as UNRECOGNIZED.\r"
            },
            {
              "line": 220,
              "text": "    role: Role.ROLE_USER,\r"
            },
            {
              "line": 221,
              "text": "    parts: [part],\r"
            },
            {
              "line": 222,
              "text": "    metadata: undefined,\r"
            },
            {
              "line": 223,
              "text": "    extensions: [],\r"
            },
            {
              "line": 224,
              "text": "    referenceTaskIds: [],\r"
            },
            {
              "line": 225,
              "text": "  };\r"
            }
          ]
        }
      ]
    },
    {
      "route_id": "amirk_a2a_to_mcp",
