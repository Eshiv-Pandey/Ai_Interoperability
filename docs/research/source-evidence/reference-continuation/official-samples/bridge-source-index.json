          "lines": [
            {
              "line": 11,
              "text": "const READ_METHODS = [\r"
            },
            {
              "line": 12,
              "text": "  \"GetTask\",\r"
            },
            {
              "line": 13,
              "text": "  \"ListTasks\",\r"
            },
            {
              "line": 14,
              "text": "  \"GetTaskPushNotificationConfig\",\r"
            },
            {
              "line": 15,
              "text": "  \"ListTaskPushNotificationConfigs\",\r"
            },
            {
              "line": 16,
              "text": "  \"GetExtendedAgentCard\",\r"
            },
            {
              "line": 17,
              "text": "] as const;\r"
            },
            {
              "line": 18,
              "text": "\r"
            },
            {
              "line": 19,
              "text": "const WRITE_METHODS = [\r"
            },
            {
              "line": 20,
              "text": "  \"SendMessage\",\r"
            },
            {
              "line": 21,
              "text": "  \"CancelTask\",\r"
            },
            {
              "line": 22,
              "text": "  \"CreateTaskPushNotificationConfig\",\r"
            },
            {
              "line": 23,
              "text": "  \"DeleteTaskPushNotificationConfig\",\r"
            },
            {
              "line": 24,
              "text": "] as const;\r"
            },
            {
              "line": 25,
              "text": "\r"
            },
            {
              "line": 26,
              "text": "/**\r"
            },
            {
              "line": 27,
              "text": " * The escape hatch: any A2A JSON-RPC method against any peer, so an RPC nobody\r"
            },
            {
              "line": 28,
              "text": " * wrapped stays reachable without a code change.\r"
            },
            {
              "line": 29,
              "text": " *\r"
            },
            {
              "line": 30,
              "text": " * Two things constrain it. The method list is an enum rather than a free string,\r"
            },
            {
              "line": 31,
              "text": " * and it narrows to the read-only half when `A2A_ALLOW_WRITES` is off — belt and\r"
            },
            {
              "line": 32,
              "text": " * braces on top of the write tools simply not existing. And the endpoint comes\r"
            },
            {
              "line": 33,
              "text": " * from the peer's own agent card, never from an argument, so this cannot be\r"
            }
          ]
        },
        {
          "start": 54,
          "end": 78,
          "lines": [
            {
              "line": 54,
              "text": "      inputSchema: {\r"
            },
            {
              "line": 55,
              "text": "        url: peerUrlArg,\r"
            },
            {
              "line": 56,
              "text": "        method: z\r"
            },
            {
              "line": 57,
              "text": "          .enum(methods)\r"
            },
            {
              "line": 58,
              "text": "          .describe(\r"
            },
            {
              "line": 59,
              "text": "            \"The A2A v1.0 RPC name, PascalCase — `GetTask`, `ListTasks`, `SendMessage`. NOT \" +\r"
            },
            {
              "line": 60,
              "text": "              \"the 0.x names (`tasks/get`, `message/send`): v1.0 renamed all of them, and an \" +\r"
            },
            {
              "line": 61,
              "text": "              \"0.x name comes back as -32601 method not found.\" +\r"
            },
            {
              "line": 62,
              "text": "              (ctx.allowWrites ? \"\" : \" Only the read-only methods are available right now.\"),\r"
            },
            {
              "line": 63,
              "text": "          ),\r"
            },
            {
              "line": 64,
              "text": "        params: z\r"
            },
            {
              "line": 65,
              "text": "          .record(z.string(), z.unknown())\r"
            },
            {
              "line": 66,
              "text": "          .default({})\r"
            },
            {
              "line": 67,
              "text": "          .describe(\r"
            },
            {
              "line": 68,
              "text": "            'The method\\'s params object, e.g. `{\"id\": \"task-abc\"}` for GetTask or ' +\r"
            },
            {
              "line": 69,
              "text": "              '`{\"pageSize\": 10}` for ListTasks. Field names are camelCase (`historyLength`, ' +\r"
            },
            {
              "line": 70,
              "text": "              \"`pageToken`) because the wire format is protobuf JSON.\",\r"
            },
            {
              "line": 71,
              "text": "          ),\r"
            },
            {
              "line": 72,
              "text": "      },\r"
            },
            {
              "line": 73,
              "text": "      // Read-only exactly when the gate is off, which is what the enum enforces.\r"
            },
            {
              "line": 74,
              "text": "      annotations: { readOnlyHint: !ctx.allowWrites, destructiveHint: ctx.allowWrites },\r"
            },
            {
              "line": 75,
              "text": "    },\r"
            },
            {
              "line": 76,
              "text": "    async ({ url, method, params }) =>\r"
            },
            {
              "line": 77,
              "text": "      wrap(async () => await ctx.peers.rawRpc(url, method, params)),\r"
            },
            {
              "line": 78,
              "text": "  );\r"
            }
          ]
        }
      ]
