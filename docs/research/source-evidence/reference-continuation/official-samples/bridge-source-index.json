      "sha256": "62c36155dd3f2438f4a629fff8cc5b1961d2f7c20bfbc5a620706a2f8218b909",
      "byte_length": 12628,
      "excerpt_ranges": [
        {
          "start": 166,
          "end": 193,
          "lines": [
            {
              "line": 166,
              "text": "  async sendMessage(\r"
            },
            {
              "line": 167,
              "text": "    url: string,\r"
            },
            {
              "line": 168,
              "text": "    args: { text: string; taskId?: string; contextId?: string; metadata?: Record<string, unknown> },\r"
            },
            {
              "line": 169,
              "text": "  ): Promise<{ result: Task | Message; sent: Message }> {\r"
            },
            {
              "line": 170,
              "text": "    const client = await this.clientFor(url);\r"
            },
            {
              "line": 171,
              "text": "    const message: Message = {\r"
            },
            {
              "line": 172,
              "text": "      messageId: randomId(\"msg\"),\r"
            },
            {
              "line": 173,
              "text": "      contextId: args.contextId ?? \"\",\r"
            },
            {
              "line": 174,
              "text": "      taskId: args.taskId ?? \"\",\r"
            },
            {
              "line": 175,
              "text": "      // ROLE_USER means \"from the client to the server\" in A2A, regardless of\r"
            },
            {
              "line": 176,
              "text": "      // whether a human or an agent composed it. Sending ROLE_AGENT here is the\r"
            },
            {
              "line": 177,
              "text": "      // easy mistake and some peers reject it.\r"
            },
            {
              "line": 178,
              "text": "      role: Role.ROLE_USER,\r"
            },
            {
              "line": 179,
              "text": "      parts: [textPart(args.text)],\r"
            },
            {
              "line": 180,
              "text": "      metadata: args.metadata,\r"
            },
            {
              "line": 181,
              "text": "      extensions: [],\r"
            },
            {
              "line": 182,
              "text": "      referenceTaskIds: [],\r"
            },
            {
              "line": 183,
              "text": "    };\r"
            },
            {
              "line": 184,
              "text": "    const result = await this.call(\r"
            },
            {
              "line": 185,
              "text": "      url,\r"
            },
            {
              "line": 186,
              "text": "      async () =>\r"
            },
            {
              "line": 187,
              "text": "        await client.sendMessage({\r"
            },
            {
              "line": 188,
              "text": "          tenant: \"\",\r"
            },
            {
              "line": 189,
              "text": "          message,\r"
            },
            {
              "line": 190,
              "text": "          configuration: undefined,\r"
            },
            {
              "line": 191,
              "text": "          metadata: undefined,\r"
            },
            {
              "line": 192,
              "text": "        }),\r"
            },
            {
              "line": 193,
              "text": "    );\r"
            }
          ]
        },
        {
          "start": 261,
          "end": 297,
          "lines": [
            {
              "line": 261,
              "text": "  async rawRpc(url: string, method: string, params: Record<string, unknown>): Promise<unknown> {\r"
            },
            {
              "line": 262,
              "text": "    const card = await this.card(url);\r"
            },
            {
              "line": 263,
              "text": "    const iface = card.supportedInterfaces.find(\r"
            },
            {
              "line": 264,
              "text": "      (candidate) => candidate.protocolBinding === \"JSONRPC\",\r"
            },
            {
              "line": 265,
              "text": "    );\r"
            },
            {
              "line": 266,
              "text": "    if (!iface) {\r"
            },
            {
              "line": 267,
              "text": "      throw new A2AApiError(`${normalizeBase(url)} advertises no JSON-RPC interface.`, {\r"
            },
            {
              "line": 268,
              "text": "        status: 0,\r"
            },
            {
              "line": 269,
              "text": "        remedy:\r"
            },
            {
              "line": 270,
              "text": "          \"Its card lists \" +\r"
            },
            {
              "line": 271,
              "text": "          (card.supportedInterfaces.map((i) => i.protocolBinding).join(\", \") || \"nothing\") +\r"
            },
            {
              "line": 272,
              "text": "          \". The escape hatch speaks JSON-RPC only; use the typed tools for the other bindings.\",\r"
            },
            {
              "line": 273,
              "text": "      });\r"
            },
            {
              "line": 274,
              "text": "    }\r"
            },
            {
              "line": 275,
              "text": "    const res = await this.rpcFetch(iface.url, {\r"
            },
            {
              "line": 276,
              "text": "      method: \"POST\",\r"
            },
            {
              "line": 277,
              "text": "      headers: { \"content-type\": \"application/json\" },\r"
            },
            {
              "line": 278,
              "text": "      body: JSON.stringify({ jsonrpc: \"2.0\", id: randomId(\"rpc\"), method, params }),\r"
            },
            {
              "line": 279,
              "text": "    });\r"
            },
            {
              "line": 280,
              "text": "    const text = await res.text();\r"
            },
            {
              "line": 281,
              "text": "    if (!res.ok) {\r"
            },
            {
              "line": 282,
              "text": "      const remedy = remedyForStatus(res.status, this.opts.token !== undefined);\r"
            },
            {
              "line": 283,
              "text": "      throw new A2AApiError(`${iface.url} answered HTTP ${res.status}: ${text.slice(0, 400)}`, {\r"
            },
            {
              "line": 284,
              "text": "        status: res.status,\r"
            },
            {
              "line": 285,
              "text": "        ...(remedy ? { remedy } : {}),\r"
            },
            {
              "line": 286,
              "text": "      });\r"
            },
            {
              "line": 287,
              "text": "    }\r"
            },
            {
              "line": 288,
              "text": "    try {\r"
            },
            {
              "line": 289,
              "text": "      return JSON.parse(text) as unknown;\r"
            },
            {
              "line": 290,
              "text": "    } catch {\r"
            },
            {
              "line": 291,
              "text": "      throw new A2AApiError(`${iface.url} answered with something that is not JSON.`, {\r"
            },
            {
              "line": 292,
              "text": "        status: res.status,\r"
            },
            {
              "line": 293,
              "text": "        errors: text.slice(0, 400),\r"
            },
            {
              "line": 294,
              "text": "      });\r"
            },
            {
              "line": 295,
              "text": "    }\r"
            },
            {
              "line": 296,
              "text": "  }\r"
            },
            {
              "line": 297,
              "text": "\r"
            }
          ]
        }
      ]
    }
