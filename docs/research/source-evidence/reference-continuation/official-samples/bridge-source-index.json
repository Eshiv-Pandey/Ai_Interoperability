      "excerpt_ranges": [
        {
          "start": 214,
          "end": 242,
          "lines": [
            {
              "line": 214,
              "text": "  cardUrl: string,\r"
            },
            {
              "line": 215,
              "text": "  card: AgentCard,\r"
            },
            {
              "line": 216,
              "text": "): AgentInterface {\r"
            },
            {
              "line": 217,
              "text": "  const candidates = (card.supportedInterfaces ?? []).filter(\r"
            },
            {
              "line": 218,
              "text": "    (entry): entry is AgentInterface =>\r"
            },
            {
              "line": 219,
              "text": "      typeof entry === \"object\" &&\r"
            },
            {
              "line": 220,
              "text": "      entry !== null &&\r"
            },
            {
              "line": 221,
              "text": "      typeof entry.url === \"string\" &&\r"
            },
            {
              "line": 222,
              "text": "      entry.url !== \"\" &&\r"
            },
            {
              "line": 223,
              "text": "      typeof entry.protocolBinding === \"string\" &&\r"
            },
            {
              "line": 224,
              "text": "      entry.protocolBinding.toLowerCase() === JSONRPC_BINDING,\r"
            },
            {
              "line": 225,
              "text": "  );\r"
            },
            {
              "line": 226,
              "text": "  const preferred =\r"
            },
            {
              "line": 227,
              "text": "    candidates.find((entry) => String(entry.protocolVersion ?? \"\").startsWith(A2A_VERSION)) ??\r"
            },
            {
              "line": 228,
              "text": "    candidates[0];\r"
            },
            {
              "line": 229,
              "text": "  if (preferred === undefined) {\r"
            },
            {
              "line": 230,
              "text": "    const bindings = (card.supportedInterfaces ?? [])\r"
            },
            {
              "line": 231,
              "text": "      .map((entry) => String((entry as { protocolBinding?: unknown }).protocolBinding))\r"
            },
            {
              "line": 232,
              "text": "      .join(\", \");\r"
            },
            {
              "line": 233,
              "text": "    throw new AgentCardError(\r"
            },
            {
              "line": 234,
              "text": "      alias,\r"
            },
            {
              "line": 235,
              "text": "      cardUrl,\r"
            },
            {
              "line": 236,
              "text": "      `no JSONRPC interface is declared. The card offers: ${bindings || \"nothing\"}. ` +\r"
            },
            {
              "line": 237,
              "text": "        \"The bridge only speaks the A2A JSON-RPC binding.\",\r"
            },
            {
              "line": 238,
              "text": "    );\r"
            },
            {
              "line": 239,
              "text": "  }\r"
            },
            {
              "line": 240,
              "text": "  return preferred;\r"
            },
            {
              "line": 241,
              "text": "}\r"
            },
            {
              "line": 242,
              "text": "\r"
            }
          ]
        }
      ]
