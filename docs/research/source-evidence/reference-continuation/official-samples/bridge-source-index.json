      "route_id": "amirk_a2a_to_mcp",
      "source_commit": "58eff9da469bccdc432bf164662727947de646b4",
      "source_path": "external/a2a-to-mcp/src/tasks/handlers.ts",
      "local_file": "amirk_a2a_to_mcp__handlers.ts",
      "sha256": "c084b0a6857c8f990875cc04ab8f2a5c9072ca969ed5db67589c597b8dda5f02",
      "byte_length": 22842,
      "excerpt_ranges": [
        {
          "start": 247,
          "end": 310,
          "lines": [
            {
              "line": 247,
              "text": "   * The acknowledgement is always the empty complete result the extension\r"
            },
            {
              "line": 248,
              "text": "   * mandates: a response whose key is not outstanding, or that arrives on a\r"
            },
            {
              "line": 249,
              "text": "   * task which is not waiting for anything, is ignored rather than refused,\r"
            },
            {
              "line": 250,
              "text": "   * because the extension says a server SHOULD ignore exactly that.\r"
            },
            {
              "line": 251,
              "text": "   */\r"
            },
            {
              "line": 252,
              "text": "  async #update(record: TaskRecord, params: unknown): Promise<Record<string, unknown>> {\r"
            },
            {
              "line": 253,
              "text": "    const view = inputResponse(readInputResponses(params), ANSWER_KEY);\r"
            },
            {
              "line": 254,
              "text": "    if (view.kind === \"elicit\" && this.#isWaiting(record)) {\r"
            },
            {
              "line": 255,
              "text": "      if (view.action === \"accept\") {\r"
            },
            {
              "line": 256,
              "text": "        const answer = readAnswer(view.content);\r"
            },
            {
              "line": 257,
              "text": "        if (answer !== undefined) {\r"
            },
            {
              "line": 258,
              "text": "          await this.#answer(record, answer);\r"
            },
            {
              "line": 259,
              "text": "        }\r"
            },
            {
              "line": 260,
              "text": "      } else {\r"
            },
            {
              "line": 261,
              "text": "        // decline and cancel both say the client will not answer, so the A2A\r"
            },
            {
              "line": 262,
              "text": "        // task is cancelled rather than left waiting until its handle expires.\r"
            },
            {
              "line": 263,
              "text": "        await this.#cancelUpstream(record);\r"
            },
            {
              "line": 264,
              "text": "      }\r"
            },
            {
              "line": 265,
              "text": "    }\r"
            },
            {
              "line": 266,
              "text": "    this.#handles.tasks.markUpdated(record.handle);\r"
            },
            {
              "line": 267,
              "text": "    return { resultType: \"complete\" };\r"
            },
            {
              "line": 268,
              "text": "  }\r"
            },
            {
              "line": 269,
              "text": "\r"
            },
            {
              "line": 270,
              "text": "  /** True while the task is parked in A2A INPUT_REQUIRED and reachable. */\r"
            },
            {
              "line": 271,
              "text": "  #isWaiting(record: TaskRecord): boolean {\r"
            },
            {
              "line": 272,
              "text": "    return (\r"
            },
            {
              "line": 273,
              "text": "      record.bridgeError === undefined &&\r"
            },
            {
              "line": 274,
              "text": "      !record.terminal &&\r"
            },
            {
              "line": 275,
              "text": "      stateOf(record.snapshot) === TaskState.TASK_STATE_INPUT_REQUIRED\r"
            },
            {
              "line": 276,
              "text": "    );\r"
            },
            {
              "line": 277,
              "text": "  }\r"
            },
            {
              "line": 278,
              "text": "\r"
            },
            {
              "line": 279,
              "text": "  /**\r"
            },
            {
              "line": 280,
              "text": "   * Sends the answer back to the agent on the same A2A task and leaves the\r"
            },
            {
              "line": 281,
              "text": "   * record running.\r"
            },
            {
              "line": 282,
              "text": "   *\r"
            },
            {
              "line": 283,
              "text": "   * The record is moved to working before the answer is even on the wire, so\r"
            },
            {
              "line": 284,
              "text": "   * that a tasks/get racing the acknowledgement can never show the question\r"
            },
            {
              "line": 285,
              "text": "   * a second time: the client has answered it and the key is gone.\r"
            },
            {
              "line": 286,
              "text": "   */\r"
            },
            {
              "line": 287,
              "text": "  async #answer(record: TaskRecord, answer: string): Promise<void> {\r"
            },
            {
              "line": 288,
              "text": "    const input: SendMessageInput = {\r"
            },
            {
              "line": 289,
              "text": "      text: answer,\r"
            },
            {
              "line": 290,
              "text": "      contextId: record.contextId,\r"
            },
            {
              "line": 291,
              "text": "      taskId: record.a2aTaskId,\r"
            },
            {
              "line": 292,
              "text": "    };\r"
            },
            {
              "line": 293,
              "text": "    this.#markWorking(record);\r"
            },
            {
              "line": 294,
              "text": "    if (!(await this.#agents.supportsStreaming(record.alias))) {\r"
            },
            {
              "line": 295,
              "text": "      await this.#upstream(record, () =>\r"
            },
            {
              "line": 296,
              "text": "        this.#agents.sendMessage(record.alias, input, { returnImmediately: true }),\r"
            },
            {
              "line": 297,
              "text": "      );\r"
            },
            {
              "line": 298,
              "text": "      await this.#refresh(record);\r"
            },
            {
              "line": 299,
              "text": "      return;\r"
            },
            {
              "line": 300,
              "text": "    }\r"
            },
            {
              "line": 301,
              "text": "    const stream = await this.#upstream(record, () =>\r"
            },
            {
              "line": 302,
              "text": "      this.#agents.sendMessageStream(record.alias, input),\r"
            },
            {
              "line": 303,
              "text": "    );\r"
            },
            {
              "line": 304,
              "text": "    record.streaming = true;\r"
            },
            {
              "line": 305,
              "text": "    // Not awaited on purpose: the client is acknowledged now, and the stream\r"
            },
            {
              "line": 306,
              "text": "    // keeps writing into the record until it closes.\r"
            },
            {
              "line": 307,
              "text": "    void this.#consume(record, stream[Symbol.asyncIterator]());\r"
            },
            {
              "line": 308,
              "text": "  }\r"
            },
            {
              "line": 309,
              "text": "\r"
            },
            {
              "line": 310,
              "text": "  /**\r"
            }
          ]
        }
      ]
