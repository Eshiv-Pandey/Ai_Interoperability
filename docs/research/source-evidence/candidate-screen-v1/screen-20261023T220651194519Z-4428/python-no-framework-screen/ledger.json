        {
          "line": 9,
          "text": "from google import genai"
        },
        {
          "line": 13,
          "text": "from no_llm_framework.server.constant import GOOGLE_API_KEY"
        },
        {
          "line": 14,
          "text": "from no_llm_framework.server.mcp import call_mcp_tool, get_mcp_tool_prompt"
        },
        {
          "line": 29,
          "text": "def stream_llm(prompt: str) -> Generator[str, None]:"
        },
        {
          "line": 30,
          "text": "    \"\"\"Stream LLM response."
        },
        {
          "line": 33,
          "text": "        prompt (str): The prompt to send to the LLM."
        },
        {
          "line": 36,
          "text": "        Generator[str, None, None]: A generator of the LLM response."
        },
        {
          "line": 38,
          "text": "    client = genai.Client(vertexai=False, api_key=GOOGLE_API_KEY)"
        },
        {
          "line": 40,
          "text": "        model='gemini-2.5-flash-lite',"
        },
        {
          "line": 47,
          "text": "    \"\"\"Agent for interacting with the Google Gemini LLM in different modes.\"\"\""
        },
        {
          "line": 59,
          "text": "    def call_llm(self, prompt: str) -> Generator[str, None]:"
        },
        {
          "line": 60,
          "text": "        \"\"\"Call the LLM with the given prompt and return a generator of responses."
        },
        {
          "line": 63,
          "text": "            prompt (str): The prompt to send to the LLM."
        },
        {
          "line": 66,
          "text": "            Generator[str, None]: A generator yielding the LLM's response."
        },
        {
          "line": 68,
          "text": "        return stream_llm(prompt)"
        },
        {
          "line": 80,
          "text": "            return self.call_llm(question)"
        },
        {
          "line": 94,
          "text": "        return self.call_llm(prompt)"
        },
        {
          "line": 100,
          "text": "            response (str): The response from the LLM."
